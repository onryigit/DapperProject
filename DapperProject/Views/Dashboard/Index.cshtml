@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var sellPressure = 100 - Model.BuyPressure;
}

<section class="page-heading">
    <div>
        <span class="eyebrow">PİYASA GENEL BAKIŞI</span>
        <h1>Analiz Dashboard</h1>
        <p>Bir milyon işlem kaydından üretilen canlı piyasa içgörüleri.</p>
    </div>
    <div class="refresh-state"><span></span> Son güncelleme: <strong>Şimdi</strong></div>
</section>

<section class="stat-grid">
    <article class="stat-card accent-green">
        <div class="stat-icon">↗</div><span>TOPLAM İŞLEM HACMİ</span>
        <strong>$@Model.Summary.TotalVolume.ToString("N0")</strong>
        <small><b>+12.8%</b> son 30 güne göre</small>
        <i class="sparkline up"></i>
    </article>
    <article class="stat-card accent-cyan">
        <div class="stat-icon">◇</div><span>TOPLAM KOMİSYON</span>
        <strong>$@Model.Summary.TotalFees.ToString("N0")</strong>
        <small><b>+8.4%</b> protokol geliri</small>
        <i class="sparkline soft"></i>
    </article>
    <article class="stat-card accent-gold">
        <div class="stat-icon">◉</div><span>EN YÜKSEK HACİMLİ PARİTE</span>
        <strong>@Model.Summary.HighestVolumePair</strong>
        <small><b>Lider</b> işlem hacmine göre</small>
        <i class="sparkline gold"></i>
    </article>
    <article class="stat-card accent-purple">
        <div class="stat-icon">⚡</div><span>ORT. İŞLEM HIZI</span>
        <strong>@Model.Summary.AverageExecutionTime.ToString("N1") <em>ms</em></strong>
        <small><b class="good">Optimal</b> düşük gecikme</small>
        <i class="sparkline purple"></i>
    </article>
</section>

<section class="dashboard-grid">
    <article class="panel chart-main">
        <div class="panel-head"><div><span class="eyebrow">30 GÜNLÜK TREND</span><h2>Hacim Dalgalanması</h2></div><span class="panel-pill">USD Hacim</span></div>
        <div id="volumeChart" class="chart-box"></div>
    </article>
    <article class="panel distribution-panel">
        <div class="panel-head"><div><span class="eyebrow">DAĞILIM</span><h2>Parite Payları</h2></div><span class="live-tag">CANLI</span></div>
        <div id="pairChart" class="chart-box donut"></div>
    </article>
    <article class="panel pressure-panel">
        <div class="panel-head"><div><span class="eyebrow">PİYASA SİNYALİ</span><h2>Alım / Satım Baskısı</h2></div></div>
        <div class="pressure-values"><span><i class="buy-dot"></i>ALIM <strong>%@Model.BuyPressure</strong></span><span>SATIM <strong>%@sellPressure</strong><i class="sell-dot"></i></span></div>
        <div class="pressure-bar"><span style="width:@Model.BuyPressure.ToString(CultureInfo.InvariantCulture)%"></span></div>
        <div id="tradeTypeChart" class="mini-chart"></div>
    </article>
    <article class="panel capacity-panel">
        <div class="panel-head"><div><span class="eyebrow">ALTYAPI</span><h2>İşleme Kapasitesi</h2></div><span class="status-ok">STABİL</span></div>
        <div class="capacity-ring" style="--value:@Model.ServerCapacityUsage.ToString(CultureInfo.InvariantCulture)"><div><strong>%@Model.ServerCapacityUsage</strong><small>Kullanım</small></div></div>
        <div class="capacity-meta"><span>İşlenen veri <b>@Model.Summary.TotalTrades.ToString("N0")</b></span><span>Hedef <b>1.35M</b></span></div>
    </article>
    <article class="panel map-panel">
        <div class="panel-head"><div><span class="eyebrow">KÜRESEL AKTİVİTE</span><h2>İşlem Yoğunluk Haritası</h2></div><span class="panel-pill">Top 10 ülke</span></div>
        <div id="tradeMap"></div>
    </article>
    <article class="panel table-panel">
        <div class="panel-head"><div><span class="eyebrow">WHALE WATCH</span><h2>En Yüksek Hacimli İşlemler</h2></div><a asp-controller="Trades" asp-action="Index">Tümünü gör →</a></div>
        <div class="table-responsive">
            <table class="trade-table compact">
                <thead><tr><th>PARİTE</th><th>TÜR</th><th>TOPLAM</th><th>KONUM</th><th>ZAMAN</th></tr></thead>
                <tbody>
                @foreach (var trade in Model.TopTransactions)
                {
                    <tr><td><span class="coin-symbol">@trade.CryptoPair[..1]</span><strong>@trade.CryptoPair</strong></td><td><span class="trade-badge @trade.TradeType.ToLowerInvariant()">@trade.TradeType</span></td><td><strong>$@trade.TotalUSD.ToString("N2")</strong></td><td>@trade.LocationCountry</td><td>@trade.TransactionDate.ToString("HH:mm")</td></tr>
                }
                </tbody>
            </table>
        </div>
    </article>
</section>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        window.tradePulseDashboard = {
            trend: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VolumeTrend.Select(x => new { date = x.TradeDate.ToString("yyyy-MM-dd"), volume = x.Volume }))),
            pairs: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PairDistribution.Select(x => new { pair = x.CryptoPair, count = x.TradeCount }))),
            types: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TradeTypeDistribution.Select(x => new { type = x.TradeType, count = x.TradeCount }))),
            countries: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CountryActivity.Select(x => new { country = x.LocationCountry, count = x.TradeCount, volume = x.Volume, lat = x.Latitude, lng = x.Longitude })))
        };
    </script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}

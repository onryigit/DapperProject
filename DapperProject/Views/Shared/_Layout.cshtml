<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b0e11" />
    <title>@ViewData["Title"] · TradePulse</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <a class="brand" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-mark"><span></span></span>
                <span><strong>Trade</strong>Pulse</span>
            </a>
            <div class="workspace-label">ANALİZ MERKEZİ</div>
            <nav class="side-nav">
                <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                    <svg viewBox="0 0 24 24"><path d="M4 13h6V4H4v9Zm0 7h6v-5H4v5Zm10 0h6v-9h-6v9Zm0-16v5h6V4h-6Z"/></svg>
                    Dashboard
                </a>
                <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Trades" ? "active" : "")" asp-controller="Trades" asp-action="Index">
                    <svg viewBox="0 0 24 24"><path d="M4 5h16v3H4V5Zm0 5h16v3H4v-3Zm0 5h16v3H4v-3Z"/></svg>
                    İşlem Verileri
                </a>
            </nav>
            <div class="sidebar-status">
                <span class="status-dot"></span>
                <div><strong>Sistem çevrimiçi</strong><small>SQL · Dapper bağlantısı</small></div>
            </div>
            <div class="sidebar-user">
                <span class="avatar">TP</span>
                <div><strong>TradePulse Admin</strong><small>Big Data Analyst</small></div>
            </div>
        </aside>

        <div class="main-area">
            <header class="topbar">
                <button class="menu-toggle" id="menuToggle" aria-label="Menüyü aç"><span></span><span></span><span></span></button>
                <div class="market-status"><span class="status-dot"></span> Piyasalar açık <small>· Canlı veri</small></div>
                <div class="topbar-actions">
                    <span class="data-badge"><i></i> 1M Veri Seti</span>
                    <span class="clock" id="liveClock"></span>
                </div>
            </header>
            <main class="content-area">
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
